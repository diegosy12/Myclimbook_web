{
  "$schema": "https://opencode.ai/config.json",
  // Modelo principal para tareas generales
  "model": "opencode-go/qwen3.7-plus",
  // Agente por defecto
  "default_agent": "build",
  // Habilitar todos para seguimiento de tareas
  "experimental": {
    "todo": true,
    "subagent_depth": 2,
    "background_compaction": true
  },
  // Configuración de agentes especializados
  "agents": {
    // Agente principal de construcción (coordinador)
    "build": {
      "model": "opencode-go/qwen3.7-plus",
      "description": "Coordinador principal del proyecto. Gestiona tareas, delega trabajo y supervisa la calidad.",
      "system": "Eres el coordinador principal del proyecto TFG DAW. Tu responsabilidad es analizar requisitos, diseñar soluciones, delegar tareas a agentes especializados cuando sea apropiado, y supervisar la calidad del código. Prioriza la eficiencia: no delegates innecesariamente, evita repetir análisis, y selecciona el modelo más adecuado para cada tarea. Sigue las convenciones definidas en AGENTS.md y ARCHITECTURE.md. Siempre verifica que el código funcione antes de considerarlo terminado.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "write", "resource": "*", "effect": "allow" }
      ]
    },
    // Arquitecto de software
    "architect": {
      "model": "opencode-go/qwen3.7-plus",
      "mode": "subagent",
      "description": "Diseña la arquitectura del sistema, define patrones de diseño y establece convenciones técnicas.",
      "system": "Eres el arquitecto de software del proyecto. Tu responsabilidad es diseñar la arquitectura general, definir patrones de diseño apropiados, establecer convenciones de código, evaluar decisiones tecnológicas y detectar problemas de escalabilidad y mantenibilidad. Proporciona soluciones claras, bien documentadas y justificadas. Considera siempre alternativas y explica el razonamiento detrás de tus decisiones.",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "write", "resource": "*.md", "effect": "allow" },
        { "action": "edit", "resource": "*.md", "effect": "allow" }
      ]
    },
    // Desarrollador backend
    "backend": {
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent",
      "description": "Implementa lógica de negocio, APIs, servicios, autenticación y gestión de bases de datos.",
      "system": "Eres el desarrollador backend del proyecto. Implementa lógica de negocio, APIs y servicios con código limpio, mantenible y bien estructurado. Sigue los principios SOLID, gestiona adecuadamente los errores, valida todas las entradas y prioriza la seguridad. Escribe código que sea fácil de testear. Utiliza el modelo Kimi K2.7 Code para tareas complejas que requieren razonamiento profundo.",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "write", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "npm *", "effect": "allow" },
        { "action": "shell", "resource": "node *", "effect": "allow" }
      ]
    },
    // Desarrollador frontend
    "frontend": {
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent",
      "description": "Implementa interfaces de usuario, componentes reutilizables y gestiona estados y navegación.",
      "system": "Eres el desarrollador frontend del proyecto. Implementa interfaces de usuario limpias, accesibles y responsive. Crea componentes reutilizables y bien documentados. Gestiona estados de forma eficiente y mantiene la coherencia visual. Prioriza la experiencia de usuario y la accesibilidad. Utiliza el modelo Kimi K2.7 Code para implementaciones complejas que requieren atención al detalle.",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "write", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "npm *", "effect": "allow" },
        { "action": "shell", "resource": "node *", "effect": "allow" }
      ]
    },
    // Especialista en bases de datos
    "database": {
      "model": "opencode-go/qwen3.7-plus",
      "mode": "subagent",
      "description": "Diseña modelos de datos, define relaciones, optimiza consultas y garantiza integridad.",
      "system": "Eres el especialista en bases de datos del proyecto. Diseña modelos de datos eficientes, define relaciones y restricciones apropiadas, optimiza consultas y diseña migraciones seguras. Garantiza la integridad y consistencia de los datos. Documenta claramente el esquema y las decisiones de diseño.",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "write", "resource": "*", "effect": "allow" }
      ]
    },
    // QA y testing
    "tester": {
      "model": "opencode-go/glm-5.3-flash",
      "mode": "subagent",
      "description": "Diseña y ejecuta pruebas unitarias, de integración y verifica casos límite.",
      "system": "Eres el especialista en QA y testing del proyecto. Diseña pruebas unitarias y de integración completas. Identifica casos límite y verifica que todas las funcionalidades cumplan los requisitos. Escribe pruebas claras, mantenibles y bien documentadas. Utiliza el modelo GLM-5.3-Flash para tareas repetitivas y generación de casos de prueba.",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "write", "resource": "*.test.*", "effect": "allow" },
        { "action": "write", "resource": "*.spec.*", "effect": "allow" },
        { "action": "shell", "resource": "npm test", "effect": "allow" },
        { "action": "shell", "resource": "npm run test*", "effect": "allow" }
      ]
    },
    // Revisor de código
    "reviewer": {
      "model": "opencode-go/qwen3.7-plus",
      "mode": "subagent",
      "description": "Revisa código, detecta errores, vulnerabilidades y verifica cumplimiento de arquitectura.",
      "system": "Eres el revisor de código del proyecto. Revisa el código generado en busca de errores lógicos, vulnerabilidades de seguridad, problemas de rendimiento y cumplimiento de la arquitectura definida. Identifica duplicidades y complejidad innecesaria. Proporciona feedback constructivo y específico. NO modifiques código, solo reporta problemas y sugerencias.",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*.review.md", "effect": "allow" }
      ]
    }
  },
  // Permisos generales
  "permissions": [
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "node *", "effect": "allow" }
  ],
  // Formateo automático
  "formatter": true,
  // Ignorar ciertos archivos en el watcher
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "build/**", ".git/**", "coverage/**"]
  }
}
